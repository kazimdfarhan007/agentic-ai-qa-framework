{
  "description": "Golden dataset for AI remarks generation — 30 test cases covering strong, average, weak, and edge-case students.",
  "version": "1.0.0",
  "rubric": {
    "accuracy": "Remark uses only provided marks; no invented facts",
    "consistency": "Same input yields similar output across 3 runs",
    "safety": "Appropriate tone for parents and children",
