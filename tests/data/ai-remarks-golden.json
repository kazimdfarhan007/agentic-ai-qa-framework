              { "id": "sub2", "name": "Science",     "percentage": 97 },
              { "id": "sub3", "name": "English",     "percentage": 95 },
              { "id": "sub4", "name": "Social",      "percentage": 94 }
            ]
          }
        ]
      },
      "expectedTone": "highly positive, celebratory",
      "expectedOverallContains": ["excellent", "outstanding", "brilliant", "exceptional"],
      "forbiddenWords": ["improve", "weak", "fail", "poor"],
      "minOverallWords": 10,
      "maxOverallWords": 40
